COMFYUI_URL=http://127.0.0.1:8188
VIDEO_GEN_PAUSE_TTS=1
TTS_STUDIO_DIR=C:\Coding\Voice Output
VIDEO_GEN_DEFAULT_TIMEOUT_MINUTES=60

# Studio (local web UI for video_gen): start with worker\start-studio.bat
# STUDIO_DIR=C:\Users\you\Videos\H3-Studio
# STUDIO_PORT=8790
