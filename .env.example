SUPABASE_SERVICE_KEY=
# Worker knobs (defaults shown; all optional)
BLENDER_EXE=C:\Users\shawn_fku5qux\AppData\Local\Programs\Blender\blender-4.5.9-windows-x64\blender.exe
RENDER_CACHE_DIR=
POLL_SECONDS=3
HEARTBEAT_SECONDS=15
