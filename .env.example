# aftereffects engine (native After Effects on this Windows host; worker/aftereffects/)
# AE_DIR=C:\Program Files\Adobe\Adobe After Effects 2026\Support Files   (auto-detected when unset)
# AE_OM_TEMPLATE=Lossless with Alpha    output-module template (RGB+Alpha); on Windows this writes an AVI
# AE_OM_KIND=mov                        mov | sequence  (what the template writes; the file AE names is picked up)
# AE_RS_TEMPLATE=Best Settings
# AE_SLOT_WAIT_SECONDS=900              one AE job at a time on this machine
# AE_FAKE_HOST=0                        1 = tests only: fake host, outputs are NOT After Effects renders
