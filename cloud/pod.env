# Non-secret settings for the RunPod pod's worker (exported by boot.sh).
# Secrets (SUPABASE_URL, SUPABASE_SERVICE_KEY) come from RunPod Secrets via the
# pod's env; WORKER_ENGINES and IDLE_EXIT_MINUTES from worker/cloud_lane.py.
RENDER_CACHE_DIR=/workspace/cache
COMFYUI_DIR=/workspace/ComfyUI
COMFYUI_URL=http://127.0.0.1:8188
BLENDER_EXE=/workspace/opt/blender/blender
HF_HOME=/workspace/cache/hf
U2NET_HOME=/workspace/models/u2net
# 96 GB VRAM / ~125 GB RAM: the 16 GB-card workarounds are off.
VIDEO_GEN_PAUSE_TTS=0
VIDEO_GEN_MIN_AVAIL_RAM_GB=0
COMFYUI_RECYCLE_ABOVE_GB=0
LIGHT_LANE=0
MATTE_GPU_MEM_LIMIT_GB=40
